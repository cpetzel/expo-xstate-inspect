{
  "compilerOptions": {
    "target": "ESNext",
    "module": "commonjs",
    "moduleResolution": "node10",
    "lib": ["ESNext", "DOM"],
    "esModuleInterop": true,
    "strict": false,
    "types": ["node"],
    "skipLibCheck": true,
    "jsx": "react-native",
    "declaration": true,
    "outDir": "./build",
    "rootDir": "./src",
    "ignoreDeprecations": "6.0"
  },
  "include": ["./src"],
  "exclude": ["**/__mocks__/*", "**/__tests__/*"]
}
