{
  "name": "expo-xstate-inspect",
  "version": "2.0.0",
  "description": "Inspect your xstate machines",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/cpetzel/expo-xstate-inspect.git"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "build:web": "cd webui && npx expo export -p web --output-dir ../dist",
    "build:all": "tsc && npm run build:web",
    "clean": "rm -rf build dist",
    "prepublishOnly": "npm run build:all",
    "web:dev": "cd webui && npx expo start -w",
    "web:export": "npm run build:web"
  },
  "keywords": [
    "expo",
    "devtools",
    "xstate"
  ],
  "files": [
    "build",
    "dist",
    "expo-module.config.json",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "fast-safe-stringify": "^2.1.1",
    "react-native-xstate-inspect-core": "^2.0.0"
  },
  "devDependencies": {
    "expo": "~57.0.28",
    "typescript": "~6.0.3",
    "xstate": "^5.33.2",
    "@types/react": "~19.2.2",
    "@types/node": "^22"
  },
  "peerDependencies": {
    "expo": ">=57",
    "xstate": "^5.13.1"
  }
}
